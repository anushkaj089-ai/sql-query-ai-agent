# Pick ONE provider and paste its free API key.
LLM_PROVIDER=groq            # groq | gemini | openrouter | openai
LLM_API_KEY=your-key-here
# Optional: override the default model for the provider (model names change over time)
# LLM_MODEL=llama-3.3-70b-versatile
# Optional: where the SQLite file lives (default app/data/company.db)
# DB_PATH=/data/company.db
